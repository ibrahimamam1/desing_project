<?xml version='1.0' encoding='utf-8'?>
<routes>
    
    
    
    
    

    
    <route id="T_straight" edges="E#T-X E#X-D" />
    <route id="T_left" edges="E#T-X E#X-R" />
    <route id="T_right" edges="E#T-X E#X-L" />

    <route id="D_straight" edges="E#D-X E#X-T" />
    <route id="D_left" edges="E#D-X E#X-L" />
    <route id="D_right" edges="E#D-X E#X-R" />

    <route id="L_straight" edges="E#L-X E#X-R" />
    <route id="L_left" edges="E#L-X E#X-T" />
    <route id="L_right" edges="E#L-X E#X-D" />

    <route id="R_straight" edges="E#R-X E#X-L" />
    <route id="R_left" edges="E#R-X E#X-D" />
    <route id="R_right" edges="E#R-X E#X-T" />

    
    <routeDistribution id="dist_T">
        <route refid="T_straight" probability="0.5" />
        <route refid="T_left" probability="0.25" />
        <route refid="T_right" probability="0.25" />
    </routeDistribution>
    <routeDistribution id="dist_D">
        <route refid="D_straight" probability="0.5" />
        <route refid="D_left" probability="0.25" />
        <route refid="D_right" probability="0.25" />
    </routeDistribution>
    <routeDistribution id="dist_L">
        <route refid="L_straight" probability="0.5" />
        <route refid="L_left" probability="0.25" />
        <route refid="L_right" probability="0.25" />
    </routeDistribution>
    <routeDistribution id="dist_R">
        <route refid="R_straight" probability="0.5" />
        <route refid="R_left" probability="0.25" />
        <route refid="R_right" probability="0.25" />
    </routeDistribution>

    
    <flow id="flow_T" route="dist_T" begin="0" end="360" probability="0.138889" departSpeed="max" />
    <flow id="flow_D" route="dist_D" begin="0" end="360" probability="0.041667" departSpeed="max" />
    <flow id="flow_L" route="dist_L" begin="0" end="360" probability="0.138889" departSpeed="max" />
    <flow id="flow_R" route="dist_R" begin="0" end="360" probability="0.041667" departSpeed="max" />
</routes>